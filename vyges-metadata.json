{
  "name": "riscduino-pwm",
  "version": "0.1.0",
  "x-version": "1.0.0",
  "description": "Silicon-proven 6-channel PWM controller with configurable glitch filter, interrupt support, and GPIO input capture. Extracted from dineshannayya/riscduino — validated on Caravel chipIgnite shuttle. Features: 6 independent PWM channels, per-channel duty cycle and period registers, digital glitch filter for noisy environments, GPIO input capture mode (useful for quadrature encoder feedback), interrupt on period completion.",
  "license": "Apache-2.0",
  "design_type": [
    "digital"
  ],
  "maturity": "imported",
  "target": [
    "asic",
    "fpga"
  ],
  "template": "standalone@1.0.0",
  "created": "2026-04-07T05:14:34Z",
  "updated": "2026-06-25T06:01:25Z",
  "categories": [
    {
      "main_category": "Interface Controllers",
      "sub_categories": [
        "Motor Control"
      ]
    }
  ],
  "keywords": [
    "pwm",
    "motor-control",
    "glitch-filter",
    "input-capture",
    "riscduino",
    "silicon-proven",
    "caravel"
  ],
  "source": {
    "type": "git",
    "url": "https://github.com/dineshannayya/riscduino",
    "ip_path": "verilog/rtl/pwm/src",
    "rtl_path": "rtl",
    "rtl_files": [
      "rtl/pwm_top.sv",
      "rtl/pwm.sv",
      "rtl/pwm_core.sv",
      "rtl/pwm_blk_reg.sv",
      "rtl/pwm_glbl_reg.sv",
      "rtl/pwm_cfg_dglitch.sv"
    ]
  },
  "integration": {
    "soc_generator_hints": {
      "top_module": "vyges_riscduino_pwm_apb",
      "rtl_files": [
        "vyges-additions/vyges_riscduino_pwm_apb.sv"
      ],
      "clock": {
        "port": "clk_i"
      },
      "reset": {
        "port": "rst_ni"
      },
      "bus_slave": {
        "addr_width": 32,
        "ports": {
          "psel": "PSEL",
          "penable": "PENABLE",
          "pwrite": "PWRITE",
          "paddr": "PADDR",
          "pwdata": "PWDATA",
          "prdata": "PRDATA",
          "pready": "PREADY"
        }
      },
      "note": "vyges_riscduino_pwm_apb (vyges-additions/) bridges clk_i/rst_ni + APB4 to pwm_top's native riscduino register bus (PREADY follows reg_ack); exposes pad_gpio[8] in, pwm_wfm[6] out, pwm_intr->IRQ."
    }
  },
  "interfaces": [
    {
      "name": "clock",
      "type": "clock",
      "direction": "input",
      "signals": [
        {
          "name": "clk_i",
          "direction": "input",
          "type": "clock",
          "width": 1
        }
      ]
    },
    {
      "name": "reset",
      "type": "reset",
      "direction": "input",
      "signals": [
        {
          "name": "rst_ni",
          "direction": "input",
          "type": "reset",
          "width": 1,
          "active_level": "low"
        }
      ]
    },
    {
      "name": "apb",
      "type": "bus",
      "protocol": "apb",
      "direction": "slave",
      "description": "APB4 slave (via the vyges facade).",
      "signals": [
        {
          "name": "PADDR",
          "direction": "input",
          "type": "address",
          "width": 32
        },
        {
          "name": "PWRITE",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PWDATA",
          "direction": "input",
          "type": "data",
          "width": 32
        },
        {
          "name": "PSEL",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PENABLE",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PREADY",
          "direction": "output",
          "type": "control",
          "width": 1
        },
        {
          "name": "PRDATA",
          "direction": "output",
          "type": "data",
          "width": 32
        }
      ]
    },
    {
      "name": "gpio_in",
      "type": "io",
      "direction": "input",
      "signals": [
        {
          "name": "pad_gpio",
          "direction": "input",
          "type": "data",
          "width": 8
        }
      ]
    },
    {
      "name": "pwm_out",
      "type": "io",
      "direction": "output",
      "signals": [
        {
          "name": "pwm_wfm",
          "direction": "output",
          "type": "data",
          "width": 6
        }
      ]
    },
    {
      "name": "irq",
      "type": "interrupt",
      "direction": "output",
      "signals": [
        {
          "name": "IRQ",
          "direction": "output",
          "type": "interrupt",
          "width": 1
        }
      ]
    }
  ],
  "parameters": [
    {
      "parameter_info": {
        "name": "NUM_PWM",
        "type": "int",
        "description": "Number of PWM channels (fixed at 6 in current implementation)"
      },
      "constraints": {
        "default": 6
      }
    }
  ],
  "branding": {
    "provider": "Vyges IP Catalog",
    "website": "https://github.com/vyges-ip/riscduino-pwm"
  },
  "community": {
    "issues": "https://github.com/vyges-ip/riscduino-pwm/issues",
    "contributions": "https://github.com/vyges-ip/riscduino-pwm/pulls"
  },
  "test": {
    "testbenches": [
      {
        "name": "upstream",
        "path": "tb/",
        "framework": "upstream",
        "description": "Upstream project's testbench harness — see source repo."
      }
    ],
    "coverage": "functional"
  }
}
